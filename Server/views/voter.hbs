<section class="page-shell narrow-shell">
  <div class="page-heading">
    <span class="eyebrow eyebrow-dark">Identificacion del votante</span>
    <h1>{{election.title}}</h1>
    <p>Ingresa tu DNI y presiona enter. Si ya estas registrado, completaremos tus datos automaticamente.</p>
  </div>
  {{#unless alreadyVoted}}
    {{#if errorMessage}}
      <div class="notice notice-error" role="alert"><p>{{errorMessage}}</p></div>
    {{/if}}
  {{/unless}}
  {{#unless lookupComplete}}
    <form class="form-card" action="/votaciones/{{electionId}}/identificacion" method="post">
      <div class="field">
        <label for="dni">DNI</label>
        <input id="dni" name="dni" type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]{7,8}" minlength="7" maxlength="8" required value="{{dni}}" aria-describedby="dni-help">
        <small id="dni-help">Escribe los 7 u 8 numeros, sin puntos.</small>
      </div>
      <div class="form-actions">
        <button class="button button-dark" type="submit">Continuar <span aria-hidden="true">→</span></button>
        <a class="text-link" href="/">Volver al inicio</a>
      </div>
    </form>
  {{else}}
    {{#if alreadyVoted}}
      <div class="notice notice-error" role="status">
        <h3>Ya participaste</h3>
        <p>El DNI {{dni}} de {{fullName}} ya voto en esta eleccion. No se puede registrar otro voto.</p>
      </div>
      <div class="form-actions">
        <a class="text-link" href="/votaciones/{{electionId}}/votar">Cambiar DNI</a>
        <a class="text-link" href="/">Volver al inicio</a>
      </div>
    {{else}}
      <form id="voter-details-form" class="form-card" action="/votaciones/{{electionId}}/seleccion" method="post">
        <input type="hidden" name="dni" value="{{dni}}">
        <div class="form-grid">
          <div class="field">
            <label for="dni">DNI</label>
            <input id="dni" type="text" value="{{dni}}" readonly>
          </div>
          <div class="field">
            <label for="fullName">Nombre completo</label>
            <input id="fullName" name="fullName" type="text" autocomplete="name" minlength="2" maxlength="60" required value="{{fullName}}" {{#if voterRegistered}}readonly aria-describedby="registered-help"{{else}}autofocus aria-describedby="manual-help"{{/if}}>
            {{#if voterRegistered}}
              <small id="registered-help">Datos encontrados en la base de usuarios.</small>
            {{else}}
              <small id="manual-help">DNI no registrado. Completa nombre y apellido para crear tu usuario y continuar.</small>
            {{/if}}
          </div>
          <div class="field">
            <label for="sex">Sexo</label>
            <select id="sex" name="sex" required {{#if voterRegistered}}readonly aria-describedby="registered-help"{{/if}}>
              <option value="">Seleccionar</option>
              <option value="M" {{#if (eq sex "M")}}selected{{/if}}>Masculino</option>
              <option value="F" {{#if (eq sex "F")}}selected{{/if}}>Femenino</option>
            </select>
          </div>
          <div class="field">
            <label for="age">Edad</label>
            <input id="age" name="age" type="number" min="0" required value="{{age}}" {{#if voterRegistered}}readonly aria-describedby="registered-help"{{/if}}>
          </div>
          <div class="field">
            <label for="email">Correo electronico</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="60" required value="{{email}}" {{#if voterRegistered}}readonly aria-describedby="registered-help"{{/if}}>
          </div>
          <div class="field">
            <label for="education">Nivel educativo</label>
            <select id="education" name="education" required {{#if voterRegistered}}readonly aria-describedby="registered-help"{{/if}}>
              <option value="">Seleccionar</option>
              <option value="Primario" {{#if (eq education "Primario")}}selected{{/if}}>Primario</option>
              <option value="Secundario" {{#if (eq education "Secundario")}}selected{{/if}}>Secundario</option>
              <option value="Terciario" {{#if (eq education "Terciario")}}selected{{/if}}>Terciario</option>
              <option value="Universitario" {{#if (eq education "Universitario")}}selected{{/if}}>Universitario</option>
            </select>
          </div>
        </div>
        <div class="form-actions">
          <button class="button button-dark" type="submit">Continuar a votar <span aria-hidden="true">→</span></button>
          <a class="text-link" href="/votaciones/{{electionId}}/votar">Cambiar DNI</a>
        </div>
      </form>
    {{/if}}
  {{/unless}}
</section>
<script src="/javascripts/javascripts.js"></script>
