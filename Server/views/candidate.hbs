<section class="page-shell narrow-shell">
  <div class="page-heading">
    <span class="eyebrow eyebrow-dark">Paso 2 de 2</span>
    <h1>{{election.title}}</h1>
    <p>Selecciona una sola candidatura para registrar tu voto.</p>
  </div>
  {{#if errorMessage}}
    <div class="notice notice-error" role="alert"><p>{{errorMessage}}</p></div>
  {{/if}}
  <p class="greeting">Votante: <strong>{{fullName}}</strong></p>
  <form class="form-card" action="/votaciones/{{electionId}}/votar" method="post">
    <input type="hidden" name="dni" value="{{dni}}">
    <div class="candidate-list">
      {{#each candidates}}
        <label class="candidate-option">
          <input type="radio" name="candidate" value="{{_id}}" required>
          <span class="candidate-content">
            <span class="radio-mark" aria-hidden="true"></span>
            <img class="candidate-image" src="{{candidateImage this ../electionId}}" alt="" loading="lazy">
            <span><span class="candidate-name">{{name}}</span><span class="candidate-description">{{description}}</span></span>
          </span>
        </label>
      {{/each}}
    </div>
    <p class="form-note">Tu eleccion se registra en esta votacion.</p>
    <div class="form-actions">
      <button class="button button-dark" type="submit">Votar</button>
      <a class="text-link" href="/votaciones/{{electionId}}/votar">Volver a mis datos</a>
    </div>
  </form>
</section>
