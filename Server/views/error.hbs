<section class="page-shell narrow-shell">
  <div class="notice notice-error">
    <span class="eyebrow eyebrow-dark">Ocurrio un problema</span>
    <h1>{{message}}</h1>
    {{#if error.status}}<p>Codigo de error: {{error.status}}</p>{{/if}}
    <a class="button button-dark" href="/">Volver al inicio</a>
  </div>
</section>
